# No API keys are required. These values are non-secret configuration.
# Vercel build: set this to the actual Render service origin.
GRIDWATCH_API_URL=https://your-service.onrender.com
# Render supplies PORT automatically. Local server uses --port 8765.
PORT=10000
# Limit math-library threads on a small Render instance.
OPENBLAS_NUM_THREADS=1
OMP_NUM_THREADS=1
# Python is pinned in render.yaml; .env is not automatically loaded.
